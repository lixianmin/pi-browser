{
	"name": "@lixianmin/pi-browser",
	"version": "1.0.0",
	"type": "module",
	"workspaces": [
		"debugger"
	],
	"files": [
		"lib",
		"src",
		"scripts",
		"test",
		"README.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		},
		"./shell/worker": {
			"types": "./lib/shell/worker.d.ts",
			"import": "./lib/shell/worker.js"
		}
	},
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && cp src/shell/busybox.wasm lib/shell/busybox.wasm",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@isomorphic-git/lightning-fs": "4.10.3",
		"diff": "8.0.4",
		"ignore": "7.0.11",
		"picomatch": "^4.0.7",
		"typebox": "1.3.27",
		"wasi-sh": "0.11.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.3",
		"fake-indexeddb": "^6.2.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
